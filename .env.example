# Copie este arquivo para ".env" (local) e cadastre as mesmas variáveis na Vercel
# em Settings > Environment Variables. Nunca envie o ".env" real para o GitHub.

# Banco de dados PostgreSQL (o schema.prisma usa PostgreSQL).
# Na Vercel use a conexão do POOLER do Supabase (porta 6543) com "?pgbouncer=true&connection_limit=1".
# A conexão direta (porta 5432) costuma falhar na Vercel por ser só IPv6. Para rodar prisma:push/seed
# no seu computador, a conexão direta funciona.
# Supabase: Project Settings > Database > Connection string > URI.
# Troque [SENHA] pela senha do banco. Se ela tiver símbolos (@, #, /), converta-os (ex.: @ vira %40).
DATABASE_URL="postgresql://postgres:[SENHA]@db.xxxxxxxx.supabase.co:5432/postgres"

# Segurança e autenticação.
# JWT_SECRET: uma frase longa e aleatória, com no mínimo 16 caracteres. Obrigatória em produção.
JWT_SECRET="troque-por-uma-frase-longa-e-aleatoria"
NODE_ENV="development"

# Provedor Fiscal (NF-e) - Seção 14 (opcional)
NFE_ENVIRONMENT="homologacao"
NFE_API_KEY=""
NFE_CERT_BASE64=""
NFE_CERT_PASSWORD=""

# Provedor WhatsApp - Seção 15 (opcional; "mock" simula os envios)
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# E-mail (código de 6 dígitos no login e no cadastro, recuperação de senha). Criar conta em resend.com,
# verificar o domínio da loja e criar a chave. Sem estas duas variáveis o código NÃO é enviado.
RESEND_API_KEY=""
EMAIL_REMETENTE="Heel Cloth <contato@heelclothing.com.br>"

# Login com Google, Facebook e Apple (opcional; cada botão só liga quando todas as variáveis do provedor existem)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
