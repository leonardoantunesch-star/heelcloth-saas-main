# Copie este arquivo para ".env" (local) e cadastre as mesmas variáveis na Vercel
# em Settings > Environment Variables. Nunca envie o ".env" real para o GitHub.

# Banco de dados PostgreSQL (o schema.prisma usa PostgreSQL).
# Supabase: Project Settings > Database > Connection string > URI.
# Troque [SENHA] pela senha do banco. Se ela tiver símbolos (@, #, /), converta-os (ex.: @ vira %40).
DATABASE_URL="postgresql://postgres:[SENHA]@db.xxxxxxxx.supabase.co:5432/postgres"

# Segurança e autenticação.
# JWT_SECRET: uma frase longa e aleatória, com no mínimo 16 caracteres. Obrigatória em produção.
JWT_SECRET="troque-por-uma-frase-longa-e-aleatoria"
NODE_ENV="development"

# Provedor Fiscal (NF-e) - Seção 14 (opcional)
NFE_ENVIRONMENT="homologacao"
NFE_API_KEY=""
NFE_CERT_BASE64=""
NFE_CERT_PASSWORD=""

# Provedor WhatsApp - Seção 15 (opcional; "mock" simula os envios)
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
